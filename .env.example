# GEMINI_API_KEY: Required for Gemini AI API calls.
# Get one free at https://aistudio.google.com/
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Primary Gemini model for text and screenshots, followed by compatible fallback models.
GEMINI_MODEL="gemini-4-hydrogen"
GEMINI_MODEL_FALLBACKS="gemini-3.5-flash-lite"

# Local port (default 3000).
PORT=3000

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
# Interface the server listens on. Default 127.0.0.1 keeps the API (which spends your
# Gemini quota and has no login) private to this computer. Set HOST=0.0.0.0 only if you
# deliberately want other devices on your network to use it.
HOST=127.0.0.1

# Timeout per Gemini model attempt, in milliseconds (default 25000).
GEMINI_TIMEOUT_MS=25000
