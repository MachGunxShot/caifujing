# GEMINI_API_KEY: Required for Gemini AI API calls.
# Get one free at https://aistudio.google.com/
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Model for all Gemini calls. A saturated model returns 503 UNAVAILABLE, so the
# request falls through to GEMINI_MODEL_FALLBACKS (comma-separated, in order).
GEMINI_MODEL="gemini-3.5-flash"
GEMINI_MODEL_FALLBACKS="gemini-3.5-flash-lite,gemini-3.1-flash-lite"

# Local port (default 3000).
PORT=3000

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
# Interface the server listens on. Default 127.0.0.1 keeps the API (which spends your
# Gemini quota and has no login) private to this computer. Set HOST=0.0.0.0 only if you
# deliberately want other devices on your network to use it.
HOST=127.0.0.1

# Per-request timeout for each Gemini call, in milliseconds (default 60000).
GEMINI_TIMEOUT_MS=60000
