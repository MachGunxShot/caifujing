# GEMINI_API_KEY: Required for Gemini AI API calls.
# Get one free at https://aistudio.google.com/
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Model for all Gemini calls. A saturated model returns 503 UNAVAILABLE, so the
# request falls through to GEMINI_MODEL_FALLBACKS (comma-separated, in order).
GEMINI_MODEL="gemini-3.5-flash"
GEMINI_MODEL_FALLBACKS="gemini-3.5-flash-lite,gemini-3.1-flash-lite"

# Local port (default 3000).
PORT=3000

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"